[Unit]
Description=<NAME>
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=3
Type=simple
ExecStart=/home/pi/.bun/bin/bun --bun --watch --env-file=/home/pi/deployment/.env /home/pi/deployment/<NAME>/index.js
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
